# quant 配置示例 —— 复制为 .env 后按需修改
# 优先级：真实环境变量 > .env 文件 > 代码内默认值
# 路径可用正斜杠，Windows 下亦可写 D:/github/quant/data

# 数据根目录（默认：项目根/data）
QUANT_DATA_DIR=D:/github/quant/data

# SQLite 主库路径（默认：QUANT_DATA_DIR/quant.db，阶段 2.2 使用）
# QUANT_DB_PATH=

# 原始 CSV 归档目录（默认：QUANT_DATA_DIR/original，阶段 2.2 使用）
# QUANT_ORIGINAL_DIR=

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
QUANT_LOG_LEVEL=INFO
